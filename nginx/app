server {
  server_name ${SERVER_NAME};

  location /version/ {
    default_type application/json;
    add_header X-Robots-Tag "noindex, nofollow, nosnippet, noarchive";
    return 200 '{"version": "1.1.0+14"}';
  }

  location /download/linux/dulno.deb {
    alias /home/dulno/app/linux/dulno.deb;
    add_header X-Robots-Tag "noindex, nofollow, nosnippet, noarchive";
  }

  location /download/windows/dulno.exe {
    alias /home/dulno/app/windows/dulno.exe;
    add_header X-Robots-Tag "noindex, nofollow, nosnippet, noarchive";
  }

  listen 80;
  server_tokens off;
}
